{
  "name": "school-letters-rag",
  "version": "0.1.0",
  "description": "Ask questions about your child's school letters and sync their dates to your calendar.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "ask": "node src/cli.ts ask",
    "sync": "node src/cli.ts sync",
    "upcoming": "node src/cli.ts upcoming",
    "search": "node src/cli.ts search",
    "compare": "node src/cli.ts compare",
    "reindex": "node src/cli.ts reindex",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "start": "node src/server.ts",
    "typecheck": "tsc -p .",
    "next:dev": "next dev",
    "next:build": "next build",
    "next:start": "next start"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jest": "^30.5.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@langchain/core": "^0.3.37",
    "@langchain/openai": "^0.3.17",
    "@langchain/pinecone": "^0.2.0",
    "@pinecone-database/pinecone": "^5.0.2",
    "langchain": "^0.3.7",
    "next": "16.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
