# Which LLM to use: claude or openai. If unset, whichever key below is filled in.
# LLM_PROVIDER=claude

ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=https://api.openai.com/v1

# CALENDAR_NAME=School letters
# Where letters/ and out/ live (default: this folder). LETTERS_DIR overrides just letters.
# DATA_DIR=/data
# LETTERS_DIR=/Users/you/Documents/School letters

# Time zone for "today" and "this Friday" (important on servers, which default to UTC)
# TZ=Australia/Melbourne

# --- Website (npm start) ---
# Required: the password to log in, at least 10 characters.
APP_PASSWORD=
# Keeps you logged in across restarts. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Optional: enables a calendar subscription URL /calendar/<token>.ics. At least 20 characters.
# Generate with: openssl rand -hex 24
# CALENDAR_TOKEN=
# PORT=3000
# Set to 1 only behind a hosting proxy (Fly.io, Render, ...). The Dockerfile sets it.
# TRUST_PROXY=1

# --- Semantic search (optional; see README "Semantic search") ---
# How questions find letters:
#   keyword   word matching only (default; no accounts or keys needed)
#   semantic  meaning-based only (needs the keys below)
#   hybrid    both, blended (recommended once the keys are set)
# SEARCH_MODE=keyword
# OPENAI_API_KEY above is reused for embeddings. Model (optional):
# EMBEDDINGS_MODEL=text-embedding-3-small
# Pinecone vector database (pinecone.io; free Starter tier):
# PINECONE_API_KEY=
# PINECONE_INDEX=school-letters
# To use Voyage AI instead of OpenAI for embeddings (needs: npm i @langchain/community):
# EMBEDDINGS_PROVIDER=voyage
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3
