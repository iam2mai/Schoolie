{
  // Type checking only. Node runs the .ts files directly by stripping types,
  // so nothing is compiled and these options mirror what Node supports.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
